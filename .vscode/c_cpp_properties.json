{
  "configurations": [
    {
      "name": "ESP-IDF",
      "compilerPath": "",
      "compileCommands": "${config:idf.buildPath}/compile_commands.json",
      "intelliSenseMode": "gcc-x86",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/build/esp-idf",
        "${env:IDF_PATH}/components/**"

      ],
      "browse": {
        "path": [
          "${workspaceFolder}/**",
          "${env:IDF_PATH}/components**"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
